{
    "compilerOptions": {
        "target": "ES2022",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "strict": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true,
        "noEmit": true,
        "types": [
            "node"
        ]
    },
    "include": [
        "src/**/*.ts"
, "src/controllers/auth/AuthGoogleController.ts"    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}